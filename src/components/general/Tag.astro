---
import { cn } from '@/utils/className'
import TablerLayoutGridFilled from '~icons/tabler/layout-grid-filled'

interface Props {
  name: string
  type?: 'tag' | 'category'
  href?: string
  count?: number
  large?: boolean
  class?: astroHTML.JSX.HTMLAttributes['class']
}

const { name, type = 'tag', href, count, large, class: classes } = Astro.props

let TagName = 'span' as 'span' | 'a'
let attrs = {}

if (href) {
  TagName = 'a'
  attrs = { href }
}
---

<TagName
  {...attrs}
  class={cn([
    'inline-block bg-indigo-600 text-white rounded-full transition-colors',
    large ? 'px-4 py-1 text-lg duration-150' : 'px-2.5 py-0.5 text-xs duration-100',
    href && 'hover:bg-yellow-300 hover:text-yellow-800',
    classes,
  ])}
>
  {type === 'category' ? (
    <TablerLayoutGridFilled class="inline-block mr-1" />
  ) : (
    <span># </span>
  )}
  <span>{name}</span>
  {count && <span> ({count})</span>}
</TagName>
