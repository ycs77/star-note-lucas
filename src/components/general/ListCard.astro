---
import type { CardModel } from '@/types'
import Date from './Date.astro'
import Draft from './Draft.astro'
import Tag from './Tag.astro'

interface Props {
  model: CardModel
  url?: string
  target?: '_blank'
  hasCategory?: boolean
  lineClamp?: boolean
}

const {
  model,
  url,
  target,
  hasCategory = false,
  lineClamp = true,
} = Astro.props
---

<div
  class:list={[
    'flex flex-col group rounded-lg shadow-md shadow-indigo-950/50 overflow-hidden md:flex-row md:transition md:duration-300 md:scale-100 md:hover:scale-105 md:hover:shadow-lg',
    model.data.image && 'md:h-48',
  ]}
>
  {model.data.image && (
    <div>
      <a
        href={model.data.url || url}
        class="block w-full md:w-auto md:h-full md:aspect-video"
        target={target}
      >
        <img src={model.data.image} alt={model.data.title} class="object-cover md:w-full md:h-full" />
      </a>
    </div>
  )}

  <div class="w-full flex flex-col justify-between min-w-0 p-6 bg-indigo-800 transition-colors duration-150 group-hover:bg-indigo-700">
    {model.data.pubDate && (
      <div class="flex items-center">
        {model.data.draft && <Draft />}
        <Date datetime={model.data.pubDate} class="text-xs" />
      </div>
    )}

    <a
      href={model.data.url || url}
      class="block mt-2"
      title={model.data.title}
      target={target}
    >
      <h5
        class:list={[
          'text-white text-xl md:text-2xl font-medium leading-tight',
          lineClamp && 'line-clamp-2 md:line-clamp-none md:truncate',
        ]}
      >
        {model.data.title}
      </h5>
    </a>

    {(model.data.description || model.excerpt) && (
      <div
        class:list={[
          'mt-2 text-indigo-200 text-sm/relaxed font-light',
          lineClamp && 'line-clamp-2',
        ]}
      >
        {model.data.description || model.excerpt}
      </div>
    )}

    {(hasCategory || model.data.tags?.length) && (
      <div class="mt-3 relative mask-r-from-80%">
        <div class="flex overflow-hidden">
          {hasCategory && <slot name="category" />}
          {model.data.tags?.map(tag => (
            <Tag name={tag} href={`/tags/${tag}`} class="mt-1 me-2 shrink-0" />
          ))}
        </div>
      </div>
    )}
  </div>
</div>
