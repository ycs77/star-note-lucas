---
import Date from './Date.astro'
import Draft from './Draft.astro'
import Tag from './Tag.astro'
import { categoriesMap } from '@/category.config'
import { parsePostSlug } from '@/utils/slug'
import type { CardModel } from '@/types'

interface Props {
  model: CardModel
  target?: '_blank'
}

const { model, target } = Astro.props
---

<div class="flex flex-col group rounded-lg shadow-md shadow-indigo-950/50 overflow-hidden md:flex-row md:h-[12rem] md:transition md:duration-300 md:scale-100 md:hover:scale-105 md:hover:shadow-lg">
  {model.data.image && (
    <div>
      <a
        href={`/posts/${parsePostSlug(model).slug}`}
        class="block w-full aspect-16/9 md:w-auto md:h-full"
        target={target}
      >
        <img src={model.data.image} alt={model.data.title} />
      </a>
    </div>
  )}

  <div class="w-full flex flex-col justify-between min-w-0 p-6 bg-indigo-800 transition-colors duration-150 group-hover:bg-indigo-700">
    {model.data.pubDate && (
      <div class="flex items-center">
        {model.data.draft && <Draft />}
        <Date datetime={model.data.pubDate} class="text-xs" />
      </div>
    )}

    <a
      href={`/posts/${parsePostSlug(model).slug}`}
      class="block mt-2"
      title={model.data.title}
      target={target}
    >
      <h5 class="text-white text-2xl font-medium leading-tight truncate">
        {model.data.title}
      </h5>
    </a>

    {(model.data.description || model.excerpt) && (
      <div class="mt-2 text-indigo-200 text-sm/[1.625] font-light line-clamp-2">
        {model.data.description || model.excerpt}
      </div>
    )}

    {(model.data.category || model.data.tags?.length) && (
      <div class="mt-3 relative mask-r-from-80%">
        <div class="flex overflow-hidden">
          {model.data.category && (
            <Tag
              type="category"
              name={categoriesMap[model.data.category].name}
              href={`/${model.data.category}`}
              class="mt-1 me-2 shrink-0"
            />
          )}
          {model.data.tags?.map(tag => (
            <Tag name={tag} href={`/tags/${tag}`} class="mt-1 me-2 shrink-0" />
          ))}
        </div>
      </div>
    )}
  </div>
</div>
