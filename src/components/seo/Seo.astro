---
import dayjs from 'dayjs'
import siteConfig from '@/site.config'

interface Props {
  type?: 'website' | 'article'
  title?: string
  description?: string
  image?: string
  date?: string | Date
  tags?: string[]
}

const {
  type = 'website',
  title,
  description,
  image,
  date,
  tags = [],
} = Astro.props as Props

const author = 'Lucas Yang'
const siteOgImage = '/images/og-image-20230331.jpg'
---

<meta name="description" content={description || siteConfig.description} />
<meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
<meta property="og:site_name" content={siteConfig.title} />
<meta property="og:type" content={type} />
<meta property="og:image" content={new URL(image || siteOgImage, Astro.site).href} />
<meta property="og:locale" content="zh-TW" />
<meta property="og:title" content={title ? `${title} | ${siteConfig.title}` : siteConfig.title} />
<meta property="og:description" content={description || siteConfig.description} />
<meta name="twitter:creator" content={`@${siteConfig.authorX}`} />
<meta name="twitter:card" content="summary_large_image" />
{type === 'article' && (
  <>
    <meta property="article:author" content={author} />
    {tags.map(tag => <meta property="article:tag" content={tag} />)}
    {date && <meta property="article:published_time" content={dayjs(date).toISOString()} />}
  </>
)}
