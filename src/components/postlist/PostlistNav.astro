---
import { categoriesMap } from '@/category'

interface Props {
  slug: keyof typeof categoriesMap | 'tags'
}

const nav = [
  ...Object.entries(categoriesMap).map(([slug, { name }]) => ({
    slug,
    label: name,
    href: `/${slug}`,
  })),
  { slug: 'tags', label: '標籤', href: '/tags' },
]
---

<div class="flex flex-wrap items-center **:w-1/2 **:mb-3 sm:**:w-auto sm:**:mb-0 sm:**:me-3">
  {nav.map(item =>
    item.slug === Astro.props.slug ? (
      <h1 class="text-3xl md:text-4xl font-serif font-medium">
        {item.label}
      </h1>
    ) : (
      <a
        href={item.href}
        class="text-3xl md:text-4xl font-serif font-medium text-indigo-200/35 hover:text-indigo-200/65"
        title={item.label}
      >
        {item.label}
      </a>
    )
  )}
</div>
