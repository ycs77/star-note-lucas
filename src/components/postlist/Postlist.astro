---
import type { CollectionEntry } from 'astro:content'
import { Card } from '@/components/general'
import { cn } from '@/utils/className'

interface Props {
  posts: (CollectionEntry<'posts'> & {
    excerpt?: string
  })[]
  class?: astroHTML.JSX.HTMLAttributes['class']
}

const { posts } = Astro.props
---

<div class={cn('mt-10', Astro.props.class)}>
  <ul class="grid gap-8">
    {posts.map(post => (
      <li class="min-w-0">
        <Card
          model={post}
          imageBaseUrl={Astro.url}
          imageSize={{ width: 592, height: 333 }}
        />
      </li>
    ))}
  </ul>

  <slot name="bottom" />
</div>
