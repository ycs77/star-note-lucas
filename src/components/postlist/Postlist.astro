---
import type { CollectionEntry } from 'astro:content'
import { ListCard, Tag } from '@/components/general'
import { categoriesMap } from '@/category.config'
import { parsePostSlug } from '@/utils/slug'
import { cn } from '@/utils/className'

interface Props {
  posts: (CollectionEntry<'posts'> & {
    excerpt?: string
  })[]
  class?: astroHTML.JSX.HTMLAttributes['class']
}

const { posts } = Astro.props
---

<div class={cn('mt-10', Astro.props.class)}>
  <ul class="grid gap-8">
    {posts.map(post => (
      <li class="min-w-0">
        <ListCard
          model={post}
          url={`/posts/${parsePostSlug(post).slug}`}
          hasCategory={!!post.data.category}
        >
          <Tag
            slot="category"
            type="category"
            name={categoriesMap[post.data.category].name}
            href={`/${post.data.category}`}
            class="mt-1 me-2 shrink-0"
          />
        </ListCard>
      </li>
    ))}
  </ul>

  <slot name="bottom" />
</div>
