---
import { nav, socialLinks } from '@/nav'
---

<footer class="my-12 text-center space-y-6">
  <ul class="flex justify-center space-x-4">
    {nav.map(item => (
      <li>
        <a
          href={item.link}
          class="flex text-indigo-300 hover:text-yellow-400 font-normal tracking-wide"
        >
          {item.text}
        </a>
      </li>
    ))}
  </ul>

  <ul class="flex items-center justify-center space-x-6">
    {socialLinks.map(link => (
      <li>
        <a
          href={link.href}
          title={link.name}
          target="_blank"
          rel="noopener noreferrer"
          class="text-white hover:text-yellow-400"
        >
          <link.icon class="size-6" />
        </a>
      </li>
    ))}
  </ul>

  <div>
    <p>© 2021-PRESENT Lucas Yang</p>
  </div>
</footer>
