---
import { Header } from '@/components/partials'
import Seo from '@/components/seo/Seo.astro'
import BgDecoration from '@/components/bg/BgDecoration.astro'
import BaseLayout from './BaseLayout.astro'

interface Props {
  title?: string
}

const { title } = Astro.props

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/'
---

<BaseLayout {title}>
  <Fragment slot="head">
    <slot name="seo">
      <Seo title={title} />
    </slot>

    <slot name="head" />
  </Fragment>

  <BgDecoration />

  <Header client:load {pathname} />

  <main>
    <slot />
  </main>

  <slot name="body" />
</BaseLayout>
