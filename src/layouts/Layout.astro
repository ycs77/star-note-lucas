---
import { ClientRouter } from 'astro:transitions'
import siteConfig from '@/site.config'
import { Header } from '@/components/partials'
import Seo from '@/components/seo/Seo.astro'
import '@/styles/index.css'

interface Props {
  title?: string
}

const { title } = Astro.props

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/'
---

<!doctype html>
<html lang="zh-Hant-TW" transition:name="root" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title ? `${title} | ${siteConfig.title}` : siteConfig.title}</title>

    <link rel="canonical" href={new URL(pathname, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.title} href={new URL('rss.xml', Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@100;300;400;500;700;900&family=Noto+Sans+SC:wght@300&family=Noto+Sans+TC:wght@100;300;400;500;700;900&family=Noto+Serif+TC:wght@200;300;400;500&display=swap" />

    <ClientRouter fallback="none" />

    <slot name="seo">
      <Seo title={title} />
    </slot>
    <slot name="head" />
  </head>
  <body>
    <!-- 光暈層 -->
    <div class="absolute inset-x-0 z-[-1] max-w-[700px] h-[400px] bg-radial-[at_0%_0%] from-indigo-800 to-indigo-900 to-50%"></div>

    <!-- 閃爍星星層 -->
    <div
      class="fixed inset-0 z-[-1] opacity-50 motion-safe:animate-stars-1-fade"
      style="background-image: url('/images/stars-1.png')"
    ></div>
    <div
      class="fixed inset-0 z-[-1] opacity-50 motion-safe:animate-stars-2-fade"
      style="background-image: url('/images/stars-2.png')"
    ></div>

    <Header client:load pathname={pathname} />

    <main>
      <slot />
    </main>

    <slot name="body" />
  </body>
</html>
