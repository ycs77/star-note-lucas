---
import Header from '@/components/Header.vue'

interface Props {
  title: string
}

const { title } = Astro.props

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/'
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>

    <link rel="canonical" href={new URL(pathname, Astro.site)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@100;300;400;500;700;900&family=Noto+Sans+SC:wght@300&family=Noto+Sans+TC:wght@100;300;400;500;700;900&family=Noto+Serif+TC:wght@200;300;400;500&display=swap" />

    <slot name="head"></slot>
  </head>
  <body>
    <div
      class="fixed inset-0 z-[-1] opacity-50 motion-safe:animate-stars-1-fade"
      style="background-image: url('/images/stars-1.png')"
    ></div>
    <div
      class="fixed inset-0 z-[-1] opacity-50 motion-safe:animate-stars-2-fade"
      style="background-image: url('/images/stars-2.png')"
    ></div>

    <Header client:load pathname={pathname} />

    <main>
      <slot />
    </main>
  </body>
</html>
