---
import InertiajsLogo from '@/../public/images/inertiajs-circle.svg'
import Container from '@/components/og/Container.astro'
---

<Container bg="wave-full" class="font-light">
  <div class="relative flex flex-col justify-center items-center h-[560px] text-white text-center">
    <InertiajsLogo class="w-[180px] h-[180px]" />
    <h2 class="text-[130px] font-light">
      <span class="text-yellow-400 font-bold">Inertia</span> v2
    </h2>
  </div>
</Container>
