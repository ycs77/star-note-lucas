---
import InertiajsLogo from '../../../public/images/inertiajs-circle.svg'
import BgWaveFull from '../../../public/images/bg-wave-full.svg'
import IonInfinite from '~icons/ion/infinite'
---

<div class="relative flex flex-col justify-between items-center w-full h-full bg-white text-indigo-900">
  <BgWaveFull class="absolute inset-x-0 top-0 w-[1200px] h-[588px]" />

  <div class="relative flex flex-col justify-center items-center h-[560px] text-white text-center">
    <InertiajsLogo class="w-[160px] h-[160px] mb-0" />
    <h2 class="text-[100px] leading-[1.2] font-light">
      <span class="text-yellow-400 font-bold">Inertia</span><span class="pr-6" /><span>無限滾動</span><span class="pr-6" /><IonInfinite class="inline-block w-36 h-36" />
    </h2>
  </div>
</div>
