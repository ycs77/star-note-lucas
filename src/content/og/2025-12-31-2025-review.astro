  <BgWaveFull class="absolute inset-x-0 top-0 w-[1200px] h-[588px]" />

  <div class="relative flex flex-col justify-center h-[560px] text-white">
    <h2 class="text-[70px] leading-[1.2] font-light">
      <span class="text-yellow-400 font-bold">Lucas</span><span class="pr-6" /><span>的</span>
    </h2>
    <h2 class="text-[240px] leading-[0.65] tracking-wider font-bold">
      2025
    </h2>
    <div class="flex justify-end">
      <h2 class="text-[70px] leading-[1.2] font-light">
        年終回顧
      </h2>
    </div>
