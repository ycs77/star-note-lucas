---
import ChromeLogo from '@/../public/images/chrome.svg'
import Container from '@/components/og/Container.astro'
---

<Container bg="wave-full" class="font-light">
  <div class="relative flex flex-col justify-center items-center h-[520px] text-white">
    <ChromeLogo class="w-[160px] h-[160px] mb-4" />
    <h2 class="text-[72px] text-center">
      <span class="text-yellow-400 font-bold">Chrome</span> DevTools MCP<br />
      <span class="text-yellow-400 font-bold">Windows</span> 與 <span class="text-yellow-400 font-bold">WSL</span> 的設定筆記
    </h2>
  </div>
</Container>
