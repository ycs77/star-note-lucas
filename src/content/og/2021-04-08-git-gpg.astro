---
import GitLogo from '../../../public/images/git.svg'
import GnupgLogo from '../../../public/images/gnupg.svg'
import BgWaveHalf from '../../components/og/BgWaveHalf.astro'
---

<div class="relative flex flex-col justify-between items-center w-full h-full bg-white text-indigo-900">
  <BgWaveHalf />

  <div class="relative flex flex-col justify-center items-center h-[300px] text-white text-center">
    <h2 class="text-[84px] leading-[1.2] font-light">
      <span class="font-thin">簽章<span class="text-yellow-400 font-bold px-4">Git</span>提交</span>
    </h2>
  </div>

  <div class="relative flex justify-center items-center h-[320px]">
    <GitLogo class="w-[150px] h-[150px]" />
    <div class="text-[72px] text-indigo-900 font-bold mx-8">+</div>
    <GnupgLogo class="w-[320px] h-[131px]" />
  </div>
</div>
