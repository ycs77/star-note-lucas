---
import type { GetStaticPaths } from 'astro'
import { categoriesMap } from '@/category.config'
import { Pagination } from '@/components/pagination'
import { Footer } from '@/components/partials'
import { Postlist, PostlistNav } from '@/components/postlist'
import Layout from '@/layouts/Layout.astro'
import { getPostCollection } from '@/post'
import { createAstroContainerWithMdx, loadPostsExcerpt } from '@/utils/article'

export const getStaticPaths = (async ({ paginate }) => {
  const slug = 'coding' as const
  const category = categoriesMap[slug].name
  const container = await createAstroContainerWithMdx()
  const posts = await loadPostsExcerpt<'posts'>(
    container,
    await getPostCollection(posts =>
      posts.filter(post => post.data.category.includes(slug))
    )
  )

  return paginate(posts, {
    pageSize: 10,
    props: { slug, category },
  })
}) satisfies GetStaticPaths

const { slug, category, page } = Astro.props
---

<Layout title={category}>
  <div class="container py-8 xl:py-12">
    <PostlistNav slug={slug} />
    <Postlist posts={page.data} />
    <Pagination
      baseUrl={page.url.current.replace(/\/\d+$/, '')}
      total={page.total}
      perPage={page.size}
      currentPage={page.currentPage}
    />
  </div>

  <div class="container">
    <Footer />
  </div>
</Layout>
