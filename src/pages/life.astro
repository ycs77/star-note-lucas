---
import { getCollection } from 'astro:content'
import { preprocessPosts } from '@/post'
import { categoriesMap } from '@/category'
import Layout from '@/layouts/Layout.astro'
import { Postlist, PostlistNav } from '@/components/postlist'
import { Footer } from '@/components/partials'
import '@/styles/index.css'

const slug = 'life'
const category = categoriesMap[slug].name

const posts = preprocessPosts(await getCollection('posts'))
  .filter(post => post.data.category.includes(slug))
---

<Layout title={category}>
  <div class="container py-8 xl:py-12">
    <PostlistNav slug={slug} />
    <Postlist posts={posts} />
  </div>

  <div class="container">
    <Footer />
  </div>
</Layout>
