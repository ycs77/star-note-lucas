---
import { Schema } from 'astro-seo-schema'
import { ArticleContainer, ArticleContent, ArticleMediumZoom, ArticleTitle } from '@/components/article'
import { Footer } from '@/components/partials'
import * as entry from '@/content/about.mdx'
import Layout from '@/layouts/Layout.astro'
import siteConfig from '@/site.config'

const { Content } = entry
---

<Layout title={entry.frontmatter.title}>
  <Fragment slot="head">
    <Schema
      item={{
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: entry.frontmatter.title,
        description: entry.frontmatter.description,
        image: [],
        author: {
          '@type': 'Person',
          name: siteConfig.author,
          url: Astro.site?.href,
        },
      }}
    />
  </Fragment>

  <ArticleContainer>
    <article>
      <ArticleTitle>{entry.frontmatter.title}</ArticleTitle>

      <div class="mt-8 md:mt-10 mb-8">
        <ArticleContent>
          <Content />
        </ArticleContent>
      </div>
    </article>
  </ArticleContainer>

  <div class="container">
    <Footer />
  </div>

  <Fragment slot="body">
    <ArticleMediumZoom />
  </Fragment>
</Layout>
