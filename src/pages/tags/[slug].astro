---
import { getCollection } from 'astro:content'
import { preprocessPosts } from '@/post'
import Layout from '@/layouts/Layout.astro'
import { Postlist } from '@/components/postlist'
import { Footer } from '@/components/partials'
import '@/styles/index.css'

export async function getStaticPaths() {
  const posts = preprocessPosts(await getCollection('posts'))
  const tags = [...new Set(posts.map(post => post.data.tags || []).flat())]
  return tags.map(tag => ({
    params: { slug: tag },
  }))
}

const slug = Astro.params.slug

const posts = preprocessPosts(await getCollection('posts'))
  .filter(post => (post.data.tags || []).includes(slug))
---

<Layout title={`標籤：${slug}`}>
  <div class="container py-8 xl:py-12">
    <h1 class="text-3xl md:text-4xl font-serif font-medium">
      <a class="text-indigo-300 hover:text-yellow-400" href="/tags">標籤</a> # {slug}
    </h1>

    <Postlist posts={posts} />
  </div>

  <div class="container">
    <Footer />
  </div>
</Layout>
