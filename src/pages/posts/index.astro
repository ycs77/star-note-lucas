---
import { getCollection } from 'astro:content'
import Layout from '@/layouts/Layout.astro'
import PostListItem from '@/components/PostListItem.vue'
import '@/styles/index.css'

const posts = await getCollection('posts')
posts.sort((a, b) => a.data.pubDate.getTime() - b.data.pubDate.getTime())
---

<Layout title="Posts">
  <div class="container py-8 xl:py-12">
    <h1 class="text-3xl md:text-4xl font-serif font-medium">文章</h1>

    <div class="mt-8">
      <ul class="space-y-12 sm:space-y-8">
        {posts.map(post => (
          <li>
            <PostListItem post={post} border />
          </li>
        ))}
      </ul>

      <!-- <Pagination /> -->
    </div>
  </div>
</Layout>
