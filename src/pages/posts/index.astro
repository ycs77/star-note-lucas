---
import { getCollection } from 'astro:content'
import Layout from '@/layouts/Layout.astro'
import { PostItem } from '@/components/general'
import { Footer } from '@/components/partials'
import '@/styles/index.css'

const posts = await getCollection('posts')
posts.sort((a, b) => a.data.pubDate.getTime() - b.data.pubDate.getTime())
---

<Layout title="文章">
  <div class="container py-8 xl:py-12">
    <h1 class="text-3xl md:text-4xl font-serif font-medium">文章</h1>

    <div class="mt-8">
      <ul class="grid gap-8">
        {posts.map(post => (
          <li class="min-w-0">
            <PostItem post={post} />
          </li>
        ))}
      </ul>

      <!-- <Pagination /> -->
    </div>
  </div>

  <div class="container">
    <Footer />
  </div>
</Layout>
