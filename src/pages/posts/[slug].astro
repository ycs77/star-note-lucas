---
import { getCollection, render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import { Schema } from 'astro-seo-schema'
import { preprocessPosts } from '@/post'
import Layout from '@/layouts/Layout.astro'
import { Date, Draft, Tag } from '@/components/general'
import { ArticleContent, ArticleTitle } from '@/components/article'
import { Footer } from '@/components/partials'
import { parsePostSlug } from '@/utils/slug'
import '@/styles/index.css'

interface Props {
  entry: CollectionEntry<'posts'>
}

export async function getStaticPaths() {
  const posts = preprocessPosts(await getCollection('posts'))
  return posts.map(entry => ({
    params: { slug: parsePostSlug(entry.id).slug },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
---

<Layout title={entry.data.title}>
  <Fragment slot="head">
    <Schema
      item={{
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: entry.data.title,
        image: [],
        datePublished: entry.data.pubDate.toISOString(),
        author: {
          '@type': 'Person',
          name: 'Lucas Yang',
          url: Astro.site?.href,
        },
      }}
    />
    </script>
  </Fragment>

  <div class="container py-8 md:!max-w-3xl xl:py-12">
    <article>
      <ArticleTitle>{entry.data.title}</ArticleTitle>

      <div class="mt-4 flex items-center flex-wrap">
        {entry.data.draft && <Draft />}
        <Date datetime={entry.data.pubDate} class="text-gray-400" />
        {entry.data.tags?.length && <span class="text-gray-400">．</span>}
        {entry.data.tags?.map(tag => (
          <Tag name={tag} href={`/tags/${tag}`} class="mr-2 my-1" />
        ))}
      </div>

      <div class="mt-8 md:mt-10 mb-8">
        <ArticleContent>
          <Content />
        </ArticleContent>
      </div>
    </article>
  </div>

  <div class="container">
    <Footer />
  </div>
</Layout>
