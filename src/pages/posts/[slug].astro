---
import { getCollection, render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import { Schema } from 'astro-seo-schema'
import { preprocessPosts } from '@/post'
import { categoriesMap } from '@/category'
import Layout from '@/layouts/Layout.astro'
import { Date, Draft, Tag } from '@/components/general'
import { ArticleContent, ArticleMediumZoom, ArticleTitle } from '@/components/article'
import { Footer } from '@/components/partials'
import { parsePostSlug } from '@/utils/slug'
import '@/styles/index.css'

interface Props {
  entry: CollectionEntry<'posts'>
}

export async function getStaticPaths() {
  const posts = preprocessPosts(await getCollection('posts'))
  return posts.map(entry => ({
    params: { slug: parsePostSlug(entry.id).slug },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
---

<Layout title={entry.data.title}>
  <Fragment slot="head">
    <Schema
      item={{
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: entry.data.title,
        image: [],
        datePublished: entry.data.pubDate.toISOString(),
        author: {
          '@type': 'Person',
          name: 'Lucas Yang',
          url: Astro.site?.href,
        },
      }}
    />
    </script>
  </Fragment>

  <div class="container py-8 md:!max-w-3xl xl:py-12">
    <article>
      <ArticleTitle>{entry.data.title}</ArticleTitle>

      <div class="mt-4 flex items-center flex-wrap">
        {entry.data.draft && <Draft />}
        <Date datetime={entry.data.pubDate} />
        {(entry.data.category || entry.data.tags?.length) && (
          <span class="text-indigo-300">．</span>
        )}
        {entry.data.category && (
          <Tag
            type="category"
            name={categoriesMap[entry.data.category].name}
            href={`/${entry.data.category}`}
            class="me-2 my-1 shrink-0"
          />
        )}
        {entry.data.tags?.map(tag => (
          <Tag name={tag} href={`/tags/${tag}`} class="me-2 my-1 shrink-0" />
        ))}
      </div>

      <div class="mt-8 md:mt-12 mb-8">
        {entry.data.image && entry.data.showImage !== false && (
          <figure class="mb-8 md:mb-12">
            <img
              class="rounded-md shadow-md shadow-indigo-950/50"
              src={entry.data.image}
              alt={
                entry.data.imageUnsplashAuthor
                  ? `Photo by ${entry.data.imageUnsplashAuthor.name} (https://unsplash.com/${entry.data.imageUnsplashAuthor.username}) on Unsplash (https://unsplash.com/)`
                  : entry.data.title
              }
            />
            {entry.data.imageUnsplashAuthor && (
              <figcaption class="text-center text-indigo-200/65 mt-4">
                <span>Photo by <a class="text-indigo-300 hover:text-yellow-400 font-medium underline" href={`https://unsplash.com/${entry.data.imageUnsplashAuthor.username}?utm_source=unsplash&amp;utm_medium=referral&amp;utm_content=creditCopyText`} target="_blank">{entry.data.imageUnsplashAuthor.name}</a> on <a class="text-indigo-300 hover:text-yellow-400 font-medium underline" href="https://unsplash.com/?utm_source=unsplash&amp;utm_medium=referral&amp;utm_content=creditCopyText" target="_blank">Unsplash</a></span>
              </figcaption>
            )}
          </figure>
        )}

        <ArticleContent>
          <Content />
        </ArticleContent>
      </div>
    </article>
  </div>

  <div class="container">
    <Footer />
  </div>

  <Fragment slot="body">
    <ArticleMediumZoom />
  </Fragment>
</Layout>
