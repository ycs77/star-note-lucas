---
import { getCollection, render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import { Schema } from 'astro-seo-schema'
import siteConfig from '@/site.config'
import { preprocessPosts } from '@/post'
import { categoriesMap } from '@/category'
import Layout from '@/layouts/Layout.astro'
import { Date, Draft, Tag } from '@/components/general'
import { ArticleContent, ArticleLicense, ArticleMediumZoom, ArticleTitle } from '@/components/article'
import { PaginationPrevNext } from '@/components/pagination'
import { Footer } from '@/components/partials'
import { parsePostSlug } from '@/utils/slug'
import '@/styles/index.css'

interface Props {
  post: CollectionEntry<'posts'>
  prev: CollectionEntry<'posts'> | null
  next: CollectionEntry<'posts'> | null
}

export async function getStaticPaths() {
  const posts = preprocessPosts(await getCollection('posts'))

  const groupedPosts = Object.keys(categoriesMap).reduce((acc, category) => {
    acc[category] = posts.filter(post => post.data.category === category)
    return acc
  }, {} as Record<string, CollectionEntry<'posts'>[]>)

  return Object.entries(groupedPosts).flatMap(([_category, posts]) => {
    return posts.map((post, i) => {
      const prev = i > 0 ? posts[i - 1] : null
      const next = i < posts.length - 1 ? posts[i + 1] : null
      return {
        params: { slug: parsePostSlug(post).slug },
        props: { post, prev, next },
      }
    })
  })
}

const { post, prev, next } = Astro.props
const { Content } = await render(post)
---

<Layout title={post.data.title}>
  <Fragment slot="head">
    <Schema
      item={{
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: post.data.title,
        image: [],
        datePublished: post.data.pubDate.toISOString(),
        author: {
          '@type': 'Person',
          name: siteConfig.author,
          url: Astro.site?.href,
        },
      }}
    />
    </script>
  </Fragment>

  <div class="container py-8 md:!max-w-3xl xl:py-12">
    <article>
      <ArticleTitle>{post.data.title}</ArticleTitle>

      <div class="mt-4 flex items-center flex-wrap">
        {post.data.draft && <Draft />}
        <Date datetime={post.data.pubDate} />
        {(post.data.category || post.data.tags?.length) && (
          <span class="text-indigo-300">．</span>
        )}
        {post.data.category && (
          <Tag
            type="category"
            name={categoriesMap[post.data.category].name}
            href={`/${post.data.category}`}
            class="me-2 my-1 shrink-0"
          />
        )}
        {post.data.tags?.map(tag => (
          <Tag name={tag} href={`/tags/${tag}`} class="me-2 my-1 shrink-0" />
        ))}
      </div>

      <div class="mt-8 md:mt-12 mb-8">
        {post.data.image && post.data.showImage !== false && (
          <figure class="mb-8 md:mb-12">
            <img
              class="rounded-md shadow-md shadow-indigo-950/50"
              src={post.data.image}
              alt={
                post.data.imageUnsplashAuthor
                  ? `Photo by ${post.data.imageUnsplashAuthor.name} (https://unsplash.com/${post.data.imageUnsplashAuthor.username}) on Unsplash (https://unsplash.com/)`
                  : post.data.title
              }
            />
            {post.data.imageUnsplashAuthor && (
              <figcaption class="text-center text-indigo-200/65 mt-4">
                <span>Photo by <a class="text-indigo-300 hover:text-yellow-400 font-medium underline" href={`https://unsplash.com/${post.data.imageUnsplashAuthor.username}?utm_source=unsplash&amp;utm_medium=referral&amp;utm_content=creditCopyText`} target="_blank">{post.data.imageUnsplashAuthor.name}</a> on <a class="text-indigo-300 hover:text-yellow-400 font-medium underline" href="https://unsplash.com/?utm_source=unsplash&amp;utm_medium=referral&amp;utm_content=creditCopyText" target="_blank">Unsplash</a></span>
              </figcaption>
            )}
          </figure>
        )}

        <ArticleContent>
          <Content />
        </ArticleContent>

        <ArticleLicense />
      </div>
    </article>

    <PaginationPrevNext prev={prev} next={next} />
  </div>

  <div class="container">
    <Footer />
  </div>

  <Fragment slot="body">
    <ArticleMediumZoom />
  </Fragment>
</Layout>
