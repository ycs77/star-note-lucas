---
import { getCollection } from 'astro:content'
import Layout from '@/layouts/Layout.astro'
import { Card } from '@/components/general'
import { Star } from '@/components/icons'
import { Footer } from '@/components/partials'
import HeroiconsArrowRight16Solid from '~icons/heroicons/arrow-right-16-solid'
import { socialLinks } from '@/nav'
import '@/styles/index.css'

const posts = await getCollection('posts')
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
---

<Layout>
  <!-- Jumbotron -->
  <div class="relative isolate h-[calc(100svh-10rem)] min-h-[500px] flex justify-center items-center pt-[100px] overflow-hidden">
    <div class="relative isolate">
      <!-- 標題 -->
      <h1 class="relative">
        <div class="text-5xl text-center xl:text-6xl font-thin motion-safe:animate-home-title">
          <span class="relative isolate inline-block w-12 h-12 md:w-20 md:h-20 mr-1 mb-1">
            <Star class="w-full h-full text-yellow-400" />
          </span>星星的筆記
        </div>

        <!-- 動畫方塊 -->
        <div class="absolute inset-0 bg-yellow-400 animate-home-title-square motion-reduce:hidden"></div>
      </h1>

      <!-- 副標題 -->
      <div class="flex text-left italic font-light tracking-widest mt-8 ml-4 text-yellow-500 motion-safe:animate-home-sign md:ml-8 md:mb-8">
        <div class="w-[200px] mx-auto">
          <div>即使是一顆小星星</div>
          <div class="mt-2 ml-8">也會閃耀著光芒<Star class="w-6 h-6 ml-1 mb-1 text-yellow-500" /></div>
        </div>
      </div>

      <!-- 流星群 -->
      <div class="absolute w-full h-full motion-reduce:hidden">
        <div class="relative top-[-90%] left-[40%] sm:top-[-150%]">
          <div class="shooting-star relative top-[-52px] left-[24px] rotate-[-35deg]">
            <div class="w-[120px] h-[4px] bg-gradient-to-r from-white rounded-full overflow-hidden animate-shooting-star [animation-delay:530ms] sm:w-[200px]"></div>
          </div>

          <div class="shooting-star relative rotate-[-35deg]">
            <div class="w-[120px] h-[4px] bg-gradient-to-r from-white rounded-full overflow-hidden animate-shooting-star [animation-delay:500ms] sm:w-[200px]"></div>
          </div>

          <div class="shooting-star relative top-[-22px] left-[79px] rotate-[-35deg]">
            <div class="w-[120px] h-[4px] bg-gradient-to-r from-white rounded-full overflow-hidden animate-shooting-star [animation-delay:550ms] sm:w-[200px]"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 作者介紹 -->
  <div class="container mb-8">
    <div class="bg-radial-[at_25%_25%] from-indigo-700 to-indigo-800 to-75% px-6 sm:px-8 py-8 rounded-lg shadow-md shadow-indigo-950/50">
      <h2 class="text-3xl md:text-4xl font-medium">
        Lucas Yang
      </h2>

      <p class="mt-4">哈囉~ 我是 Lucas~ 歡迎來到我的小站~</p>
      <p class="mt-4">我是來自台灣的學生，現在在讀國立空中大學的管理與資訊學系。</p>
      <p class="mt-4">平常的喜好是宅在家刻網站、看動漫、玩遊戲等。</p>
      <p class="mt-4">
        <a href="/about" class="inline-flex items-center px-4 py-1.5 bg-indigo-500 hover:bg-yellow-300 text-white hover:text-yellow-800 text-sm font-normal rounded-full transition-colors duration-150">
          <HeroiconsArrowRight16Solid class="size-4 mr-1" /> 更多關於我
        </a>
      </p>

      <ul class="flex items-center space-x-5 mt-8">
        {socialLinks.map(link => (
          <li>
            <a
              href={link.href}
              title={link.name}
              target="_blank"
              rel="noopener noreferrer"
              class="text-white hover:text-yellow-400"
            >
              <link.icon class="size-6" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- 文章列表 -->
  <div class="container mb-24">
    <div class="mt-8">
      <ul class="grid gap-8">
        {posts.map(post => (
          <li class="min-w-0">
            <Card model={post} />
          </li>
        ))}
      </ul>

      <div class="text-center mt-8 lg:mt-12">
        <a href="/posts" class="inline-block px-10 py-3 bg-indigo-600 hover:bg-yellow-300 text-white hover:text-yellow-800 font-normal tracking-wide rounded-full transition-colors duration-150">
          全部文章
        </a>
      </div>
    </div>
  </div>

  <div class="container">
    <Footer />
  </div>
</Layout>
