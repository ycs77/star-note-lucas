---
import { Footer } from '@/components/partials'
import projects from '@/content/projects'
import Layout from '@/layouts/Layout.astro'
---

<Layout title="專案">
  <div class="container py-8 xl:py-12">
    <h1 class="text-3xl md:text-4xl font-serif font-medium">
      專案
    </h1>

    <div class="mt-4 text-gray-300 leading-7">
      自己有做了一些專案，有些是興趣，有些是在做網站時抽離出來的小套件~
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 sm:gap-6 lg:gap-8">
      {projects.map(project => (
        <div>
          <a href={project.url} class="group" target="_blank">
            <h2 class="text-xl text-indigo-300 group-hover:text-yellow-400 font-medium">
              {project.title}
            </h2>
            <p class="mt-1 text-gray-300 text-sm">{project.description}</p>
            {/* <div class="mt-2 flex flex-wrap gap-2">
              {project.tags.map(tag => (
                <Tag name={tag} class="text-xs" />
              ))}
            </div> */}
          </a>
        </div>
      ))}
    </div>
  </div>

  <div class="container">
    <Footer />
  </div>
</Layout>
