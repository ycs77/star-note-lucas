---
import { Tag } from '@/components/general'
import { Footer } from '@/components/partials'
import projects from '@/content/projects'
import Layout from '@/layouts/Layout.astro'
---

<Layout title="專案">
  <div class="container py-8 xl:py-12">
    <h1 class="text-3xl md:text-4xl font-serif font-medium">
      專案
    </h1>

    <div class="mt-4 text-post-content leading-7">
      自己有做了一些專案，有些是興趣，有些是在做網站時抽離出來的小套件~
    </div>

    {projects.map(category => (
      <div class="mt-12">
        <h2 class="text-xl md:text-2xl font-serif font-medium">
          {category.title}
        </h2>

        <div class="mt-4 grid gap-4 sm:grid-cols-2 sm:gap-6 lg:gap-8">
          {category.projects.map(project => (
            <div class="group flex flex-col p-6 bg-indigo-800 rounded-lg shadow-md shadow-indigo-950/50 overflow-hidden md:hover:bg-indigo-700 md:transition md:duration-300 md:scale-100 md:hover:scale-105 md:hover:shadow-lg transition-colors duration-150">
              <a
                href={project.url}
                class="block"
                target="_blank"
              >
                <h5 class="text-white text-xl md:text-2xl font-medium leading-tight line-clamp-2">
                  {project.title}
                </h5>
              </a>

              <div class="mt-2 mb-auto text-indigo-200 text-sm/relaxed font-light line-clamp-2">
                {project.description}
              </div>

              {project.tags && (
                <div class="mt-3 relative mask-r-from-80%">
                  <div class="flex overflow-hidden">
                    {project.tags?.map(tag => (
                      <Tag name={tag} class="mt-1 me-2 shrink-0" />
                    ))}
                  </div>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>

  <div class="container">
    <Footer />
  </div>
</Layout>
