---
import BaseLayout from '@/layouts/BaseLayout.astro'
import BgDecoration from '@/components/bg/BgDecoration.astro'
import Star from '@/components/icons/Star.vue'
import HeroiconsArrowLeft20Solid from '~icons/heroicons/arrow-left-20-solid'
---

<BaseLayout title="404 Not Found">
  <BgDecoration />

  <div class="h-screen flex justify-center items-center text-white text-center">
    <div>
      <Star class="w-12 h-12 text-yellow-400 tracking-wider" />
      <h1 class="mt-6 font-light text-3xl md:text-4xl">啊！此頁面不存在...</h1>
      <a
        href="/"
        class="mt-8 group inline-block px-8 py-3 bg-indigo-800 hover:bg-indigo-700 text-white rounded-full tracking-wider transition-colors duration-300 ease-in-out"
      >
        <HeroiconsArrowLeft20Solid class="w-5 h-5 inline-block group-hover:-translate-x-1 transition-transform duration-200 ease-in-out" />
        返回首頁
      </a>
    </div>
  </div>
</BaseLayout>
