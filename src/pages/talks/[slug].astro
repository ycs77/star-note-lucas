---
import type { CollectionEntry } from 'astro:content'
import { Schema } from 'astro-seo-schema'
import { getCollection, render } from 'astro:content'
import { ArticleContainer, ArticleContent, ArticleMediumZoom, ArticleTitle } from '@/components/article'
import { Date, PostBackLink } from '@/components/general'
import { Footer } from '@/components/partials'
import Seo from '@/components/seo/Seo.astro'
import Layout from '@/layouts/Layout.astro'
import siteConfig from '@/site.config'
import { parsePostSlug } from '@/utils/slug'

interface Props {
  talk: CollectionEntry<'talks'>
}

export async function getStaticPaths() {
  const talks = await getCollection('talks')

  return talks.map(talk => ({
    params: { slug: parsePostSlug(talk).slug },
    props: { talk },
  }))
}

const { talk } = Astro.props
const { Content } = await render(talk)
---

<Layout title={talk.data.title}>
  <Fragment slot="seo">
    <Seo
      type="article"
      title={talk.data.title}
      description={talk.data.description}
      date={talk.data.pubDate}
    />
  </Fragment>

  <Fragment slot="head">
    <Schema
      item={{
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: talk.data.title,
        image: [],
        datePublished: talk.data.pubDate.toISOString(),
        author: {
          '@type': 'Person',
          name: siteConfig.author,
          url: Astro.site?.href,
        },
      }}
    />
  </Fragment>

  <ArticleContainer>
    <PostBackLink href="/talks">
      返回演講分享列表
    </PostBackLink>

    <article>
      <ArticleTitle class="xl:text-4xl/[1.25]">
        {talk.data.title}
      </ArticleTitle>

      <div class="mt-4 flex items-center flex-wrap">
        <Date datetime={talk.data.pubDate} />
      </div>

      <div class="mt-8 md:mt-12 mb-8">
        <ArticleContent>
          <Content />
        </ArticleContent>
      </div>
    </article>
  </ArticleContainer>

  <div class="container">
    <Footer />
  </div>

  <Fragment slot="body">
    <ArticleMediumZoom />
  </Fragment>
</Layout>
