---
import Layout from '@/layouts/Layout.astro'
import { Star } from '@/components/icons'
import { ArticleContent } from '@/components/article'
import { Footer } from '@/components/partials'
import friendLinks from '@/content/friendLinks'
---

<Layout title="友情連結">
  <div class="container !max-w-screen-md py-8 xl:py-12">
    <h1 class="text-3xl md:text-4xl font-serif font-medium">
      友情連結
    </h1>

    <div class="mt-4 mb-10 text-gray-300 leading-7">
      這裡是友情連結~
    </div>

    <div class="grid gap-4 sm:grid-cols-2 sm:gap-6 lg:gap-8">
      {friendLinks.map(friendLink => (
        <div>
          <a href={friendLink.link} class="group flex items-center" target="_blank">
            {friendLink.avatar ? (
              <img src={friendLink.avatar} alt={friendLink.name} class="w-20 h-20 mr-3 rounded-full" />
            ) : (
              <div class="flex justify-center items-center w-20 h-20 mr-3 rounded-full border-2 border-yellow-400">
                <Star class="w-8 h-8 text-yellow-400" />
              </div>
            )}
            <div>
              <h2 class="text-xl text-indigo-300 group-hover:text-yellow-400 font-medium font-serif">
                {friendLink.name}
              </h2>
              <p class="mt-1 text-indigo-100 text-sm">{friendLink.description}</p>
            </div>
          </a>
        </div>
      ))}
    </div>

    <div class="mt-20">
      <h2 class="text-2xl font-serif font-medium">
        <Star class="w-8 h-8 mr-2 mb-2 text-yellow-400" />申請友情連結
      </h2>

      <div class="mt-4">
        <span class="font-medium">主旨：</span>申請友情連結
      </div>
      <div class="mt-3">
        <span class="font-medium">內容：</span>
        <ArticleContent class="mt-3">
          <pre><code>暱稱：
網站標題：
網址：需要有 https://
簡介：
大頭貼連結：需要有 https://</code></pre>
        </ArticleContent>
      </div>

      <p class="mt-4">申請連結之前請先將本站加入您的友情連結，非常感謝~ 然後將以上內容填寫完以後發送到 <a href="mailto:ycs77lucasv@gmail.com" class="text-indigo-300 hover:text-yellow-400 underline font-medium">ycs77lucasv@gmail.com</a>，網站要有 HTTPS，且有獨立的域名。</p>
      <p class="mt-4">不接受商業宣傳或違反法律、道德的網站。失聯或關聯度不高的話會不告知刪除。</p>

      <p class="mt-8 -mb-4 sm:mb-4">本站資訊：</p>
      <ArticleContent>
        <pre class="mt-8"><code>網站標題：星星的筆記．Lucas
網址：https://star-note-lucas.me/
簡介：即使是一顆小星星 也會閃耀著光芒✨
大頭貼連結：https://star-note-lucas.me/logo.png</code></pre>
      </ArticleContent>
    </div>
  </div>

  <div class="container">
    <Footer />
  </div>
</Layout>
