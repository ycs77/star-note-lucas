{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/github", "destination": "https://github.com/ycs77" },
    { "source": "/gh", "destination": "https://github.com/ycs77" },
    { "source": "/twitter", "destination": "https://x.com/ycs77_lucas" },
    { "source": "/x", "destination": "https://x.com/ycs77_lucas" },
    { "source": "/bsky", "destination": "https://bsky.app/profile/ycs77.star-note-lucas.me" },
    { "source": "/sponsor", "destination": "https://www.patreon.com/c/ycs77" },
    { "source": "/patreon", "destination": "https://www.patreon.com/c/ycs77" },
    { "source": "/fb", "destination": "https://www.facebook.com/star.note.lucas.77/" },
    { "source": "/discord", "destination": "https://discord.gg/2R6YFZjmGK" },
    { "source": "/rss", "destination": "https://star-note-lucas.me/rss.xml" },

    { "source": "/post", "destination": "/coding" },
    { "source": "/posts", "destination": "/coding" },
    { "source": "/post/:path*", "destination": "/posts/:path*" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</rss.xml>; rel=\"service-desc\", </sitemap-index.xml>; rel=\"describedby\""
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
